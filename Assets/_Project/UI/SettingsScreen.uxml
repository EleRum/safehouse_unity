<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:sh="Safehouse.UI.Chrome">
    <ui:Style src="Theme.uss" />

    <!--
      The SETTINGS screen: game options and data-folder management.
      Laid out in exact pixels against the same 1440x900 artboard as the other screens.
    -->
    <ui:VisualElement name="settings-root" class="gear-root" style="flex-direction: column;">

        <!-- TOP BAR -->
        <ui:VisualElement class="bar bar-top">
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-right: 22px;">
                <ui:Label text="SAFEHOUSE" class="text-heading" />
            </ui:VisualElement>
            <ui:Button text="CHARACTER" name="navtab-character" class="navtab" />
            <ui:Button text="SCENES" name="navtab-gm" class="navtab" />
            <ui:Button text="GEAR" name="navtab-gear" class="navtab" />
            <ui:Button text="HIDEOUT" name="navtab-hideout" class="navtab" />
            <ui:Button text="TRADERS" name="navtab-traders" class="navtab" />
            <ui:Button text="SCAVENGE" name="navtab-scavenge" class="navtab" />
            <ui:Button text="QUESTS" name="navtab-quests" class="navtab" />
            <ui:VisualElement style="flex-grow: 1;" />
            <ui:Button text="SETTINGS" name="navtab-settings" class="navtab navtab-active" />
        </ui:VisualElement>

        <!-- MAIN -->
        <ui:VisualElement style="flex-grow: 1; flex-direction: row; padding: 14px 24px; min-height: 0;">
            <sh:FacetedPanel style="width: 420px; flex-shrink: 0; flex-direction: column; padding: 14px; margin-right: 16px;">
                <ui:Label text="SETTINGS" class="text-section" style="margin-bottom: 10px;" />
                <ui:Label text="Game data and options. Most settings require a restart to take effect." class="text-muted" style="font-size: 11px; white-space: normal; margin-bottom: 14px;" />

                <ui:VisualElement class="card" style="padding: 10px 12px; margin-bottom: 10px;">
                    <ui:Label text="DATA FOLDER" class="text-label" />
                    <ui:Label name="label-data-folder" text="—" class="text-mono" style="font-size: 11px; white-space: normal; margin-top: 4px;" />
                    <ui:Button name="button-open-folder" text="OPEN FOLDER" class="btn btn-outline" style="margin-top: 8px; font-size: 11px; height: 26px;" />
                </ui:VisualElement>

                <ui:VisualElement class="card" style="padding: 10px 12px; margin-bottom: 10px;">
                    <ui:Label text="AUDIO" class="text-label" style="margin-bottom: 8px;" />
                    <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 6px;">
                        <ui:Label text="MUSIC" class="text-mono" style="width: 54px; font-size: 11px;" />
                        <ui:Slider name="slider-music" low-value="0" high-value="100" value="45" style="flex-grow: 1; margin-right: 10px;" />
                        <ui:Label name="label-music" text="45" class="text-mono text-accent" style="width: 32px; font-size: 11px; -unity-text-align: middle-right;" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
                        <ui:Label text="SFX" class="text-mono" style="width: 54px; font-size: 11px;" />
                        <ui:Slider name="slider-sfx" low-value="0" high-value="100" value="70" style="flex-grow: 1; margin-right: 10px;" />
                        <ui:Label name="label-sfx" text="70" class="text-mono text-accent" style="width: 32px; font-size: 11px; -unity-text-align: middle-right;" />
                    </ui:VisualElement>
                    <ui:Button name="button-test-sound" text="PLAY A SOUND" class="btn btn-outline" style="font-size: 11px; height: 26px;" />
                    <ui:Label text="Both volumes are kept in PlayerPrefs. Drop audio/&lt;id&gt;.wav next to the game's data files to replace the built-in sounds." class="text-muted" style="font-size: 10px; white-space: normal; margin-top: 8px;" />
                </ui:VisualElement>

                <ui:VisualElement class="card" style="padding: 10px 12px; margin-bottom: 10px;">
                    <ui:Label text="QUIT" class="text-label" style="margin-bottom: 8px;" />
                    <ui:Button name="button-exit" text="EXIT GAME" class="btn btn-outline" style="font-size: 12px; height: 30px;" />
                    <ui:Label name="label-quit" text="Saves are written as you go; nothing is lost by quitting." class="text-muted" style="font-size: 10px; white-space: normal; margin-top: 8px;" />
                </ui:VisualElement>

                <ui:VisualElement style="flex-grow: 1;" />                <ui:Label name="label-status" text="" class="text-muted" style="font-size: 11px; white-space: normal;" />
            </sh:FacetedPanel>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
